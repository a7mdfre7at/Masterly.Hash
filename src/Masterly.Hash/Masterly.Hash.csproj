<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Description>Password hashing you can't get wrong: Argon2id with dated, compiled-in profiles, upgrade-on-login, constant-time verification, user-enumeration protection, peppers with key rotation, and transparent migration of legacy hashes.</Description>
    <PackageTags>Security;Hash;Password;Argon2;Argon2id;PBKDF2;Salt;Pepper;Crypto;PasswordHashing</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
  </ItemGroup>


  <ItemGroup>
    <InternalsVisibleTo Include="Masterly.Hash.UnitTests" />
  </ItemGroup>

</Project>
