<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Description>ASP.NET Core integration for Masterly.Hash: an ASP.NET Core Identity IPasswordHasher&lt;TUser&gt; adapter that keeps verifying existing Identity v2/v3 hashes and upgrades them to Argon2id on login, an IExceptionHandler that maps PasswordHasherBusyException to HTTP 503 with Retry-After, and a minimal API endpoint filter that rejects over-long passwords before hashing.</Description>
    <PackageTags>Security;Hash;Password;Argon2;Argon2id;PBKDF2;PasswordHashing;AspNetCore;Identity;AspNetIdentity;MinimalApi;ExceptionHandler</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Masterly.Hash\Masterly.Hash.csproj" />
    <ProjectReference Include="..\Masterly.Hash.Legacy\Masterly.Hash.Legacy.csproj" />
    <ProjectReference Include="..\Masterly.Hash.DependencyInjection\Masterly.Hash.DependencyInjection.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Masterly.Hash.AspNetCore.Tests" />
  </ItemGroup>

</Project>
