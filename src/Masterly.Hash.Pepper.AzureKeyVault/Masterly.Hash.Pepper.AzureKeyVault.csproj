<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Description>Azure Key Vault pepper for Masterly.Hash: loads pepper keys from Key Vault secrets (each secret version is a key id), caches them in memory with periodic refresh, and computes HMAC-SHA256 locally.</Description>
    <PackageTags>Security;Password;PasswordHashing;Pepper;HMAC;Azure;KeyVault;Secrets;Masterly.Hash</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Masterly.Hash\Masterly.Hash.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.12.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Masterly.Hash.Pepper.AzureKeyVault.Tests" />
  </ItemGroup>

</Project>
