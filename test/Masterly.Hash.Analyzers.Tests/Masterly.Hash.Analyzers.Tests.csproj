<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Roslyn version the analyzer is compiled against; the testing library brings no Roslyn of its own. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.8.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.4" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.CodeFix.Testing" Version="1.1.4" />
    <!-- Lifts the vulnerable transitive 9.0.6 (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx) pulled in via NuGet.Packaging. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <!--
      ReferenceAssemblies.Net.Net80 resolves this package from the NuGet global packages folder. Downloading it
      at restore time means the tests themselves never touch the network.
    -->
    <PackageDownload Include="Microsoft.NETCore.App.Ref" Version="[8.0.0]" />
    <PackageDownload Include="NETStandard.Library" Version="[2.0.3]" />
    <PackageDownload Include="Microsoft.NETCore.Platforms" Version="[1.1.0]" />
  </ItemGroup>

  <ItemGroup>
    <!-- Clears every package source, so reference-assembly resolution can only use the global packages folder. -->
    <None Include="offline.nuget.config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Masterly.Hash.Analyzers\Masterly.Hash.Analyzers.csproj" />
  </ItemGroup>

</Project>
